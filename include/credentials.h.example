/**
 * @brief MQTT broker hostname or address.
 */
#define CRED_BROKER_HOST ""
/**
 * @brief MQTT broker TCP port.
 */
#define CRED_BROKER_PORT 1883
/**
 * @brief MQTT username.
 */
#define CRED_MQTT_USER ""
/**
 * @brief MQTT password.
 *
 * @warning Authentication secret; do not publish.
 */
#define CRED_MQTT_PASSWORD ""
/**
 * @brief APN used for LTE data attachment.
 */
#define CRED_APN_NAME "iot.1nce.net"
